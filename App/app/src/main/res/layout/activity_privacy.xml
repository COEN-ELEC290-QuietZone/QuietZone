<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PrivacyActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@color/app_on_primary"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/my_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QuietZone values your privacy. This app is designed to help users find quiet study spaces using live environmental noise data."
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Information we collect"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Your name and email address when you create an account or log in\n• Your saved rooms, favorites, and app preferences\n• Live room noise level data collected from our sensors\n• Location information only if you grant permission and the feature requires it"
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How we use your information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We use this information to:\n• show your profile information\n• save your favorite rooms and preferences\n• display live and recent noise levels in study spaces\n• improve the app experience and basic functionality"
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noise monitoring"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QuietZone measures ambient sound levels in study areas through sensors. The system is intended to monitor noise intensity only. It is not designed to record private conversations or store audio recordings."
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data storage"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your account and app data may be stored securely using Firebase services."
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data sharing"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We do not sell your personal information. Your data is only used for app functionality and project-related purposes."
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your choices"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You can:\n• choose whether to grant location permission\n• manage your saved rooms and preferences\n• contact us if you want your account data removed"
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Security"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We take reasonable steps to protect your information, but no system can guarantee complete security."
                android:textSize="16sp"
                android:textColor="@color/app_on_background"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>